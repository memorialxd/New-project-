# Copy to .env.development (or .env.local) and fill in values.
# Frontend keys below are safe to expose in the browser.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_your_stripe_publishable_key

# Optional — Mapbox can also be provided at runtime via the get-mapbox-token edge function
# VITE_MAPBOX_TOKEN=pk.your_mapbox_token
